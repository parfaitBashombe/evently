generator client {
  provider = "prisma-client"
  output   = "../src/app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RsvpStatus {
  going
  maybe
  not_going
}

enum EventStatus {
  draft
  published
  cancelled
}

model Event {
  id          String      @id @default(uuid()) @db.Uuid
  ownerUserId String      @map("owner_user_id")
  title       String
  content     String?     @db.Text
  description String?
  coverImage  String?     @map("cover_image")
  location    String?
  category    String?
  capacity    Int?
  status      EventStatus @default(draft)
  isPublic    Boolean     @default(false) @map("is_public")
  eventDate   DateTime?   @map("event_date") @db.Timestamptz(6)
  endDate     DateTime?   @map("end_date") @db.Timestamptz(6)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  invite   EventInvite?
  rsvps    EventRsvp[]
  comments EventComment[]
  likes    EventLike[]

  @@index([ownerUserId, createdAt(sort: Desc)], map: "idx_events_owner")
  @@map("events")
}

model EventInvite {
  id        String   @id @default(uuid()) @db.Uuid
  eventId   String   @unique @map("event_id") @db.Uuid
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  event Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  rsvps EventRsvp[]

  @@map("event_invites")
}

model EventRsvp {
  id              String     @id @default(uuid()) @db.Uuid
  eventId         String     @map("event_id") @db.Uuid
  inviteId        String?    @map("invite_id") @db.Uuid
  name            String
  email           String
  emailNormalized String     @map("email_normalized")
  status          RsvpStatus
  message         String?    @db.Text
  respondedAt     DateTime   @default(now()) @map("responded_at") @db.Timestamptz(6)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  event  Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  invite EventInvite? @relation(fields: [inviteId], references: [id], onDelete: SetNull)

  @@unique([eventId, emailNormalized])
  @@index([eventId, respondedAt(sort: Desc)], map: "idx_rsvps_event")
  @@map("event_rsvps")
}

model EventComment {
  id        String   @id @default(uuid()) @db.Uuid
  eventId   String   @map("event_id") @db.Uuid
  name      String
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, createdAt(sort: Desc)], map: "idx_comments_event")
  @@map("event_comments")
}

model EventLike {
  id          String   @id @default(uuid()) @db.Uuid
  eventId     String   @map("event_id") @db.Uuid
  fingerprint String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, fingerprint])
  @@index([eventId], map: "idx_likes_event")
  @@map("event_likes")
}
